{
  "tasks": {
    "start": "deno run -A src/server.ts",
    "dev": "deno run -A --watch src/server.ts",
    "build": "deno cache src/server.ts",
    "build:frontend": "cd ../TreesFrontend && yarn build",
    "build:all": "deno task build:frontend && deno task build",
    "test": "deno test -A test/api.test.ts"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "express": "npm:express@^5.2.1",
    "mongoose": "npm:mongoose@^9.9.2",
    "morgan": "npm:morgan@^1.11.0",
    "cors": "npm:cors@^2.8.5"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": false
  },
  "nodeModulesDir": "auto"
}
